<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portfolio | Đào Toàn Thắng</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: #0f172a;
            color: #f8fafc;
            line-height: 1.6;
        }

        nav {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 18px 8%;
            background: rgba(15, 23, 42, 0.9);
            backdrop-filter: blur(10px);
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
        }

        nav .logo {
            font-size: 24px;
            font-weight: bold;
            color: #38bdf8;
        }

        nav ul {
            list-style: none;
            display: flex;
            gap: 30px;
        }

        nav a {
            color: white;
            text-decoration: none;
            transition: 0.3s;
        }

        nav a:hover {
            color: #38bdf8;
        }

        section {
            padding: 100px 8%;
        }

        #home {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            background: linear-gradient(135deg, #0f172a, #172554);
        }

        .hero h1 {
            font-size: 60px;
            margin-bottom: 15px;
        }

        .hero h1 span {
            color: #38bdf8;
        }

        .hero p {
            font-size: 20px;
            color: #cbd5e1;
            margin-bottom: 30px;
        }

        .button {
            display: inline-block;
            padding: 12px 25px;
            background: #38bdf8;
            color: #0f172a;
            text-decoration: none;
            border-radius: 8px;
            font-weight: bold;
            transition: 0.3s;
        }

        .button:hover {
            transform: translateY(-3px);
            background: #7dd3fc;
        }

        .title {
            text-align: center;
            font-size: 36px;
            margin-bottom: 50px;
        }

        .about {
            max-width: 800px;
            margin: auto;
            text-align: center;
            color: #cbd5e1;
            font-size: 18px;
        }

        .skills {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 20px;
            max-width: 900px;
            margin: auto;
        }

        .skill {
            background: #1e293b;
            padding: 25px;
            border-radius: 12px;
            text-align: center;
            transition: 0.3s;
        }

        .skill:hover {
            transform: translateY(-5px);
            background: #263449;
        }

        .projects {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 25px;
        }

        .project {
            background: #1e293b;
            padding: 25px;
            border-radius: 12px;
        }

        .project h3 {
            color: #38bdf8;
            margin-bottom: 10px;
        }

        .project p {
            color: #cbd5e1;
            margin-bottom: 15px;
        }

        footer {
            text-align: center;
            padding: 30px;
            background: #020617;
            color: #94a3b8;
        }

        @media (max-width: 600px) {
            nav ul {
                display: none;
            }

            .hero h1 {
                font-size: 40px;
            }

            .hero p {
                font-size: 17px;
            }
        }
    </style>
</head>

<body>

    <!-- NAVIGATION -->
    <nav>
        <div class="logo">Thắng.dev</div>

        <ul>
            <li><a href="#home">Trang chủ</a></li>
            <li><a href="#about">Giới thiệu</a></li>
            <li><a href="#skills">Kỹ năng</a></li>
            <li><a href="#projects">Dự án</a></li>
        </ul>
    </nav>


    <!-- HOME -->
    <section id="home">
        <div class="hero">
            <h1>Xin chào, tôi là <span>Thắng</span></h1>

            <p>Sinh viên Công nghệ thông tin | Developer tương lai</p>

            <a href="#projects" class="button">
                Xem dự án
            </a>
        </div>
    </section>


    <!-- ABOUT -->
    <section id="about">
        <h2 class="title">Giới thiệu</h2>

        <div class="about">
            <p>
                Tôi là sinh viên ngành Công nghệ thông tin.
                Tôi đang học lập trình và từng bước xây dựng
                những sản phẩm của riêng mình.
            </p>

            <br>

            <p>
                Mục tiêu của tôi là trở thành một lập trình viên
                chuyên nghiệp và phát triển những sản phẩm công nghệ
                có ích.
            </p>
        </div>
    </section>


    <!-- SKILLS -->
    <section id="skills">
        <h2 class="title">Kỹ năng</h2>

        <div class="skills">

            <div class="skill">
                <h3>HTML</h3>
                <p>Cơ bản</p>
            </div>

            <div class="skill">
                <h3>CSS</h3>
                <p>Cơ bản</p>
            </div>

            <div class="skill">
                <h3>JavaScript</h3>
                <p>Đang học</p>
            </div>

            <div class="skill">
                <h3>C / C++</h3>
                <p>Đang học</p>
            </div>

            <div class="skill">
                <h3>Git</h3>
                <p>Đang học</p>
            </div>

            <div class="skill">
                <h3>SQL</h3>
                <p>Đang học</p>
            </div>

        </div>
    </section>


    <!-- PROJECTS -->
    <section id="projects">
        <h2 class="title">Dự án</h2>

        <div class="projects">

            <div class="project">
                <h3>Project 01</h3>

                <p>
                    Website portfolio cá nhân được xây dựng
                    bằng HTML và CSS.
                </p>

                <a href="#" class="button">
                    Xem project
                </a>
            </div>


            <div class="project">
                <h3>Project 02</h3>

                <p>
                    Một dự án cá nhân đang được phát triển.
                </p>

                <a href="#" class="button">
                    Coming soon
                </a>
            </div>


            <div class="project">
                <h3>Project 03</h3>

                <p>
                    Dự án tiếp theo sẽ được cập nhật tại đây.
                </p>

                <a href="#" class="button">
                    Coming soon
                </a>
            </div>

        </div>
    </section>


    <!-- FOOTER -->
    <footer>
        <p>© 2026 Thắng.dev | Built with HTML & CSS</p>
    </footer>

</body>
</html>
